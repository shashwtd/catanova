# These are examples; the application reads environment variables from its process.
# Node 24 can load this file with --env-file=.env (see README).
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/probe.sqlite
# Comma-separated exact browser origins. Same-origin browsers work automatically; add development or trusted extra origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only when running behind your controlled reverse proxy: its exact network CIDR.
# Leave empty for direct access. Never trust public client-supplied forwarding headers.
# TRUSTED_PROXY_CIDRS=

# Google login: both values are PUBLIC configuration, available in Supabase's Connect dialog.
# Enable Google and configure redirects first; see docs/AUTH.md.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# REQUIRE_AUTH=true
# Production requires authentication by default. Only for an isolated local test:
# ALLOW_LOCAL_PLAYTEST=true

# Optional Turnstile CAPTCHA for guest signup. This site key is public runtime configuration.
# Configure the matching secret in Supabase Authentication settings, never in this repository or app.
# TURNSTILE_SITE_KEY=YOUR_PUBLIC_SITE_KEY

# Bot players. Without a key the Add bot control still works and bots still
# play, from their deterministic fallbacks alone; with one they think with
# TypeSafe AI's Jev decision model.
#
# Set one of these. TypeSafe's own API is preferred and used first; the two
# gateways are fallbacks for when you only have a key for one of them.
# TYPESAFE_API_KEY=            # https://console.typesafe.ai/settings/keys
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
#
# Force a route when several keys are present: typesafe | openrouter | vercel.
# CATANOVA_BOT_ROUTE=typesafe
# Pin a build rather than a moving alias. Defaults per route: jev-latest,
# ~typesafe/jev-latest, typesafe-ai/jev.
# CATANOVA_BOT_MODEL=jev-1.13.0
