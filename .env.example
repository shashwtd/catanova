# These are examples; the application reads environment variables from its process.
# Node 24 can load this file with --env-file=.env (see README).
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/probe.sqlite
# Comma-separated exact browser origins. Same-origin browsers work automatically; add development or trusted extra origins.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google login: both values are PUBLIC configuration, available in Supabase's Connect dialog.
# Enable Google and configure redirects first; see docs/AUTH.md.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# REQUIRE_AUTH=true
# Production requires authentication by default. Only for an isolated local test:
# ALLOW_LOCAL_PLAYTEST=true
