# Copy to .env in this directory. Every value below without a default is required; blanks fail
# before startup. Production keeps this file at /etc/catanova/production.env (root, mode 0600).
# One DNS hostname only, with no https://, port, path, commas, or whitespace.
# Prefer catanova.io from the first public release; an Azure DNS name is optional for a preview.
CATANOVA_DOMAIN=
# Set to the actual private Compose subnet after inspecting the deployment network.
# This lets Caddy forward client IPs for room-code limits. Leave empty for direct access.
TRUSTED_PROXY_CIDRS=

# Full 40-character commit from the reviewed public repository checkout being built.
CATANOVA_REVISION=

# Public configuration. The game server verifies players against this project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Production site key with CATANOVA_DOMAIN allowed in Cloudflare Turnstile.
# Its secret stays in Supabase Auth CAPTCHA settings, never in this file/container.
TURNSTILE_SITE_KEY=

# Optional bot decision service. Keep the real key only in the server's private env file.
TYPESAFE_API_KEY=
CATANOVA_BOT_MODEL=jev-latest

# Game modes (docs/GAME-MODES.md, "How the modes ship"). The admin console's Modes tab opens and
# closes modes and adds testers while the server runs, and wins over these two; leave them empty
# and use the console. They are read once at start-up, as the starting point for what the console
# has not set. Classic is always open.
# Modes every host may pick, as ruleset ids separated by commas, such as big-table-v1.
# Empty means Classic only. An id this release does not know is logged and ignored.
CATANOVA_MODES=
# Account ids, separated by commas, that are testers whatever the console says: their rooms may
# pick every mode open to testers. An account id is in the admin console's player address.
CATANOVA_MODE_TESTERS=

# Admin console, reachable only through Cloudflare Access and a Cloudflare Tunnel (docs/ADMIN.md).
# The tunnel token is a secret: whoever holds it can serve this tunnel. Never commit or share it.
TUNNEL_TOKEN=
# The Zero Trust team domain without https://, such as yourteam.cloudflareaccess.com
ADMIN_ACCESS_TEAM_DOMAIN=
# The Access application's Application Audience (AUD) tag: 64 hexadecimal characters.
ADMIN_ACCESS_AUD=
# Comma-separated addresses allowed in. Keep it identical to the Access policy's allowed emails.
ADMIN_EMAILS=
ADMIN_ORIGIN=https://admin.catanova.io

# REQUIRE_AUTH=true and ALLOW_LOCAL_PLAYTEST=false are fixed in compose.yaml.
# Do not add Google client secrets, Supabase secret/service-role keys, or database passwords.
