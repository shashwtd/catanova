# Copy to .env in this directory. All five values are required; blanks fail before startup.
# One DNS hostname only, with no https://, port, path, commas, or whitespace.
# Prefer catanova.io from the first public release; an Azure DNS name is optional for a preview.
CATANOVA_DOMAIN=
# Set to the actual private Compose subnet after inspecting the deployment network.
# This lets Caddy forward client IPs for room-code limits. Leave empty for direct access.
TRUSTED_PROXY_CIDRS=

# Full 40-character commit from the reviewed public repository checkout being built.
CATANOVA_REVISION=

# Public configuration. The game server verifies players against this project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Production site key with CATANOVA_DOMAIN allowed in Cloudflare Turnstile.
# Its secret stays in Supabase Auth CAPTCHA settings, never in this file/container.
TURNSTILE_SITE_KEY=

# REQUIRE_AUTH=true and ALLOW_LOCAL_PLAYTEST=false are fixed in compose.yaml.
# Do not add Google client secrets, Supabase secret/service-role keys, or database passwords.
