# Install as /etc/catanova/backup.env, owned by root and mode 0600.
# Obtain this from docker volume inspect catanova-game-data on the deployed VM.
# Replace the example if Docker's data-root is on a different managed-disk path.
CATANOVA_BACKUP_DATABASE_PATH=/srv/catanova/docker/volumes/catanova-game-data/_data/probe.sqlite
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# No storage keys, connection strings, SAS tokens or managed-identity tokens here.
