# Install as /etc/catanova/backup.env, owned by root and mode 0600.
# Obtain this from docker volume inspect catanova-game-data on the deployed VM.
# Replace the example if Docker's data-root is on a different managed-disk path.
CATANOVA_BACKUP_DATABASE_PATH=/srv/catanova/docker/volumes/catanova-game-data/_data/probe.sqlite
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# Optional dead-man's switch: the healthchecks.io "catanova-backup" check's ping URL,
# e.g. https://hc-ping.com/<uuid>. Success posts to it; failure posts to <url>/fail with
# the reason. A ping that fails is logged and never fails the backup. Empty: no pings.
BACKUP_PING_URL=
# Where backup.json is written for the watchdog and admin console. Default shown.
CATANOVA_STATUS_DIRECTORY=/srv/catanova/status

# No storage keys, connection strings, SAS tokens or managed-identity tokens here.
