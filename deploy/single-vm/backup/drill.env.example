# Install as /etc/catanova/drill.env, owned by root and mode 0600.
# The drill also reads /etc/catanova/backup.env for the storage account and container.

# Dead-man's switch: the healthchecks.io "catanova-restore-drill" check's ping URL,
# e.g. https://hc-ping.com/<uuid>. A passing drill posts to it; a failing drill posts to
# <url>/fail with the reason (never room ids or game data). Empty: no pings.
DRILL_PING_URL=

# Optional: the game image to verify with. Empty means the image the running catanova-game
# container uses, which is exactly the deployed release.
CATANOVA_DRILL_IMAGE=

# URLs here are secrets: anyone holding one can report on this check.
