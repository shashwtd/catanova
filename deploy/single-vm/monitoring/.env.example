# Install as /etc/catanova/watchdog.env, owned by root and mode 0600.
# The public hostname to check over HTTPS, exactly as in CATANOVA_DOMAIN of production.env.
CATANOVA_DOMAIN=catanova.io

# Dead-man's switch: the healthchecks.io "catanova-watchdog" check's ping URL,
# e.g. https://hc-ping.com/<uuid>. Every run posts to it; a failed check posts to
# <url>/fail with the reason. If pings stop (VM down, timer stopped) the service alerts.
WATCHDOG_PING_URL=

# Optional direct push alert, sent only when the set of failing checks changes, every
# six hours while it persists, and once on recovery. Either an ntfy.sh topic URL
# (https://ntfy.sh/<long-random-topic>; anyone who knows the topic can read it) with
# ALERT_WEBHOOK_KIND=text, or a Discord channel webhook URL with ALERT_WEBHOOK_KIND=discord.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=text

# Optional thresholds; defaults shown.
WATCHDOG_DISK_PERCENT_MAX=85
WATCHDOG_CERT_MIN_DAYS=14
WATCHDOG_BACKUP_MAX_AGE_MINUTES=35
# Where backup.json is read and watchdog.json is written.
CATANOVA_STATUS_DIRECTORY=/srv/catanova/status

# URLs here are secrets: anyone holding one can report on, or read, these alerts.
